{
  "name": "aurora-vpn",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "start": "react-native start",
    "test": "jest",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "build:debug": "cd android && ./gradlew assembleDebug",
    "build:release": "cd android && ./gradlew bundleRelease"
  },
  "dependencies": {
    "@react-native-community/netinfo": "11.4.1",
    "react": "18.3.1",
    "react-native": "0.76.5",
    "react-native-linear-gradient": "2.8.3",
    "react-native-safe-area-context": "4.14.0",
    "react-native-svg": "15.9.0",
    "zustand": "5.0.2"
  },
  "devDependencies": {
    "@babel/core": "7.26.0",
    "@babel/preset-env": "7.26.0",
    "@react-native/babel-preset": "0.76.5",
    "@react-native/eslint-config": "0.76.5",
    "@react-native/metro-config": "0.76.5",
    "@react-native/typescript-config": "0.76.5",
    "@types/jest": "29.5.14",
    "@types/react": "18.3.17",
    "@types/react-test-renderer": "18.3.0",
    "eslint": "8.57.1",
    "jest": "29.7.0",
    "react-test-renderer": "18.3.1",
    "ts-jest": "29.2.5",
    "typescript": "5.7.2"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/__tests__/**/*.test.ts"
    ],
    "//": "Node, not the react-native preset: every test here drives plain TypeScript with injected dependencies, so the suite runs in CI with no emulator and no native module. Component tests would need 'preset': 'react-native'."
  },
  "engines": {
    "node": ">=18"
  }
}
